#!/bin/sh
# Block commits that contain secrets: this repo is public.
# Enable on a fresh clone:  git config core.hooksPath .githooks
# Bypass for a known false positive:  git commit --no-verify
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found (brew install gitleaks); refusing to commit unscanned." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
